# Copy to .env.local for local development (never commit .env.local).
#
# Base URL of the OceanSight FastAPI backend, without a trailing slash.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time: change it, then rebuild/redeploy.
#
# Local development: the backend started with `uvicorn app.main:app --port 8100` from backend/.
# Vercel (Production/Preview): set NEXT_PUBLIC_API_URL to the deployed backend, e.g. https://<your-backend-host>
#   — never localhost. If it is missing in a production build, the app serves only the bundled offline snapshots.
# This value is public (it ships to every visitor); never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8100
