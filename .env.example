# Copy to .env and fill in. Every value is optional: without credentials the pipeline
# uses the open (no-login) NOAA/HYCOM sources documented in docs/DECISIONS.md D-002.

# --- Database (docker/docker-compose.yml starts PostGIS with these defaults) ---
DATABASE_URL=postgresql+psycopg://oceanembed:oceanembed@localhost:5433/oceanembed

# --- Data directory (processed Zarr stores, model outputs) ---
OCEANEMBED_DATA_DIR=./ml/data

# --- Spec-primary data sources (free accounts) ---
# Used only by the offline pipeline. The API never downloads with them; /v1/meta and /v1/provenance report only
# whether they are configured (never their values). Without them every feature works except the optional
# GLORYS subsurface salinity layer (`python -m ml.pipeline.build_dataset salinity`).
# Copernicus Marine: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Copernicus Climate Data Store (ERA5): https://cds.climate.copernicus.eu/profile
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
# NASA Earthdata (optional cross-check products)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# (The API reads its data from OCEANEMBED_DATA_DIR on local/mounted disk; there is no object-storage client.)

# --- Optional NL assistant (the app works fully without it: templated fallback) ---
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- API ---
# Comma-separated exact frontend origins, e.g. http://localhost:3100,https://<your-project>.vercel.app
CORS_ORIGINS=http://localhost:3100
# Optional regex for Vercel preview deployments, e.g. https://oceanembed-[a-z0-9-]+\.vercel\.app (empty = off)
CORS_ORIGIN_REGEX=
MODEL_VERSION=
LOG_LEVEL=INFO
# Hard cap on points returned by /v1/volume/sample for the 3-D view (browser budget; default 20000, max 20000)
MAX_3D_POINTS=20000
