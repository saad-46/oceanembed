# Copy to .env and fill in. Every value is optional: without credentials the pipeline
# uses the open (no-login) NOAA/HYCOM sources documented in docs/DECISIONS.md D-002.

# --- Database (docker/docker-compose.yml starts PostGIS with these defaults) ---
DATABASE_URL=postgresql+psycopg://oceanembed:oceanembed@localhost:5433/oceanembed

# --- Data directory (processed Zarr stores, model outputs) ---
OCEANEMBED_DATA_DIR=./ml/data

# --- Spec-primary data sources (free accounts) ---
# Copernicus Marine: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Copernicus Climate Data Store (ERA5): https://cds.climate.copernicus.eu/profile
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
# NASA Earthdata (optional cross-check products)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Object storage (optional; local disk is used when empty) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Optional NL assistant (the app works fully without it: templated fallback) ---
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# --- API ---
CORS_ORIGINS=http://localhost:3100
MODEL_VERSION=
